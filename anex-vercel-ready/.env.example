# Database: Vercel Postgres / Neon / any PostgreSQL-compatible pooled URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Operator login for /desk
ANEX_OPERATOR_EMAIL=operator@anexglobal.uk
ANEX_OPERATOR_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH

# DeepL automatic chat translation
DEEPL_API_KEY=
# Free plan: https://api-free.deepl.com ; Pro: https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com

# Used only to hash IP addresses for abuse prevention. Use 32+ random chars.
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Public canonical URL. For preview you can leave the default.
NEXT_PUBLIC_SITE_URL=https://anexglobal.uk
